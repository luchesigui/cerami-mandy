# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Base URL of the storefront (used for generating absolute URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Melhor Envio (shipping quotes). Token from Melhor Envio > Integrações > Permissões de acesso
# with the "shipping-calculate" scope. Use a sandbox token while MELHOR_ENVIO_ENV=sandbox.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_ENV=sandbox
# Required by Melhor Envio: "App name (contact email)"
MELHOR_ENVIO_USER_AGENT="Cerami Mandy (contato@example.com)"

# CEP the parcels are shipped from (digits only)
SHIPPING_ORIGIN_CEP=

# Sanity token with Editor permission (sanity.io/manage > API > Tokens). Server only:
# creates orders, reserves and sells pieces. Never expose it to the browser.
SANITY_API_WRITE_TOKEN=

# AbacatePay (Pix). Use the dev mode key while testing.
ABACATEPAY_API_KEY=
# Secret added to the webhook URL: /api/webhooks/abacatepay?webhookSecret=<value>
ABACATEPAY_WEBHOOK_SECRET=
# "true" enables the "Simular pagamento" button and endpoint (sandbox only)
ABACATEPAY_DEV_MODE=true
