{
  "name": "cerami-mandy",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "storefront:dev": "turbo dev --filter=@cerami/storefront",
    "studio:dev": "npm --prefix studio-cerami-mandy run dev"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "ajv": "^8.13.0",
    "eslint": "^9.39.4",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  },
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  },
  "dependencies": {
    "vercel": "^62.1.0"
  }
}
